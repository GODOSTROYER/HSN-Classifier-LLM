# ─── Agent Provider Configuration ───
# Available providers: openrouter, custom, local
AGENT_PROVIDER=openrouter

# ─── OpenRouter Settings (Used if AGENT_PROVIDER=openrouter) ───
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
MODEL_ID=google/gemma-4-31b-it:free

# ─── Custom API Settings (Used if AGENT_PROVIDER=custom) ───
CUSTOM_AGENT_API_URL=http://localhost:8000/api/agent
CUSTOM_AGENT_API_KEY=your_custom_api_key

# ─── Local Agent Settings (Used if AGENT_PROVIDER=local) ───
LOCAL_AGENT_PATH=./agents/local-agent

# ─── Server Settings ───
HOST=127.0.0.1
PORT=8899
